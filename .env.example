# ───────────────────────── Discord (مطلوب) ─────────────────────────
# https://discord.com/developers/applications → تطبيقك → Bot → Reset Token
DISCORD_TOKEN=
# General Information → Application ID
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret (مطلوب للوحة التحكم)
DISCORD_CLIENT_SECRET=
# (اختياري) ID السيرفر: تتسجل أوامر السلاش فيه فوراً
DISCORD_GUILD_ID=

# ───────────────────────── لوحة التحكم ─────────────────────────
# الدومين العام للبوت (HTTPS) — مطلوب لتسجيل الدخول والـ Webhooks
PUBLIC_URL=https://bot.example.com
# نفس الدومين بدون https:// (يستخدمه Caddy لإصدار شهادة HTTPS تلقائياً)
DOMAIN=bot.example.com
PORT=3000
# ولّدها بـ: npm run secrets
SESSION_SECRET=
# IDs ديسكورد اللي يدخلون اللوحة دائماً (مفصولة بفاصلة)
ADMIN_USER_IDS=

# ───────────────────────── Twitch ─────────────────────────
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# سر EventSub (إشعار فوري) — ولّده بـ npm run secrets
TWITCH_EVENTSUB_SECRET=

# ───────────────────────── Kick ─────────────────────────
# https://kick.com/settings/developer  (فعّل Webhooks وحط الرابط: PUBLIC_URL/webhooks/kick)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# كيك ما عنده API رسمي للـ VOD والكليبات. true = يحاول بطريقة غير رسمية (شروط كيك تمنع السحب الآلي — على مسؤوليتك)
KICK_UNOFFICIAL_CONTENT=false

# ───────────────────────── YouTube ─────────────────────────
# Google Cloud Console → YouTube Data API v3 → API key
YOUTUBE_API_KEY=
# سر WebSub (إشعار فوري للمقاطع) — ولّده بـ npm run secrets
YOUTUBE_WEBSUB_SECRET=

# ───────────────────────── TikTok (غير رسمي، ما يحتاج مفاتيح) ─────────────────────────
# (اختياري) مفتاح Euler Stream لتحسين كشف لايف تيك توك
TIKTOK_SIGN_API_KEY=
# (اختياري) RSSHub محلي كبديل لمقاطع تيك توك، مثال: http://rsshub:1200
RSSHUB_URL=

# ───────────────────────── متقدم ─────────────────────────
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info
# فترات الفحص بالثواني
POLL_TWITCH_LIVE=60
POLL_KICK_LIVE=60
POLL_YOUTUBE_LIVE=120
POLL_TIKTOK_LIVE=120
POLL_CONTENT=300
POLL_TIKTOK_CONTENT=900
# كم ثانية لازم يكون أوفلاين قبل ما ينتهي البث (ضد انقطاع النت)
OFFLINE_GRACE_SECONDS=150
STALE_LIVE_MINUTES=30
