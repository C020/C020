{
  "name": "stream-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot for streamers: live roles + notifications for Twitch, Kick, YouTube and TikTok, with a web dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/index.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc -p tsconfig.json",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p dashboard/tsconfig.json --noEmit",
    "test": "vitest run && vitest run --config dashboard/vitest.config.ts",
    "test:watch": "vitest",
    "secrets": "node scripts/generate-secrets.mjs",
    "test:server": "vitest run",
    "test:dashboard": "vitest run --config dashboard/vitest.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "discord.js": "^14.27.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.50.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
